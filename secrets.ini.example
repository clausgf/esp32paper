; esp32paper — one-time device seed secrets as build flags (alternative to
; include/settings.h).
;
; Copy this file to `secrets.ini` (git-ignored) and fill in your values, then
; enable it in platformio.ini by uncommenting BOTH:
;   [platformio] extra_configs = secrets.ini
;   [env]        build_flags   = ${secrets.seed_flags}   (add to the list)
;
; Build + flash ONCE with this to seed the values into the device's NVS. Omit it
; (the default) for the SECRETLESS build used for OTA updates / public CI — the
; device then reuses the values already in NVS. See README "Secrets".
;
; Note: a firmware built WITH these flags contains the values in plaintext in the
; .bin — keep such a build local, never publish it.
;
; Quoting: a C string literal must survive the ini + compiler, hence the
; '"..."' wrapping (single quotes around the double-quoted string).

[secrets]
seed_flags =
    -DIOT_WIFI_SSID='"my-wifi"'
    -DIOT_WIFI_PASSWORD='"my-password"'
    -DIOT_API_URL='"http://192.168.178.20:8000/api"'
    -DIOT_PROJECT='"my-project"'
    -DIOT_PROVISIONING_TOKEN='"P-102-FX61O...=="'
    ; Bump to force re-seeding changed values with a new firmware:
    -DIOT_SEED_GENERATION=1
